# Copy to .env for local development: cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by the app.
DATABASE_URL=postgres://beebase:beebase@localhost:5435/beebase_inspection?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used by docker-compose to provision the postgres container.
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase_inspection

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://beebase:beebase@localhost:5435/beebase_inspection_test?sslmode=disable

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Required: hive-service's base URL. An inspection can only be created
# under a hive the caller owns; this service confirms that (and,
# transitively, apiary ownership) by forwarding the caller's own access
# token to hive-service's GET /api/v1/hives/{id}.
HIVE_SERVICE_URL=http://localhost:8083

# `docker compose up` (via beebase-gateway) overrides both of the above
# to in-network addresses — you don't need to change them for that path.
