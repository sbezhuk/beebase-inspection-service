# TEMPLATE ONLY — documents every variable this service accepts.
# Never loaded by the app, Docker Compose, or deployment tooling.
# Copy it once to create your real, git-ignored config:
#   cp .env.example .env

# development | production
APP_ENV=development

# debug | info | warn | error
LOG_LEVEL=debug

HTTP_PORT=8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Used by docker-compose to provision the postgres container, and to
# build DATABASE_URL below (kept in sync automatically - only ever
# change the password here, not in DATABASE_URL itself).
POSTGRES_USER=beebase
POSTGRES_PASSWORD=beebase
POSTGRES_DB=beebase_inspection
# `docker compose up` (via beebase-gateway) overrides these two to
# inspection-postgres/5432 — you don't need to change them for that path.
POSTGRES_HOST=localhost
POSTGRES_PORT=5435

# Used by the app. Built from the POSTGRES_* values above so the
# password never needs to be duplicated/retyped here.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_CONNECT_TIMEOUT=5s

# Used only by `make test-integration`, never by the app itself.
TEST_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/beebase_inspection_test?sslmode=disable

# Required: the shared session store. Every BeeBase service (not just
# auth-service) checks it on every request, so an access token can be
# rejected the instant its session is superseded by a newer one instead
# of staying valid until its own JWT expiry.
REDIS_ADDR=localhost:6379
REDIS_CONNECT_TIMEOUT=5s
# `docker compose up` (via beebase-gateway) overrides this to the
# in-network Redis address — you don't need to change it for that path.

# Required: auth-service's public key endpoint, used to verify access
# tokens without ever holding a key that could mint one.
AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json

# Required shared credential for internal reminder cleanup and existence calls.
# Set this only in local runtime configuration;
INTERNAL_SERVICE_TOKEN=

# Required: hive-service's base URL. An inspection can only be created
# under a hive the caller owns; this service confirms that (and,
# transitively, apiary ownership) by forwarding the caller's own access
# token to hive-service's GET /api/v1/hives/{id}.
HIVE_SERVICE_URL=http://localhost:8083

# Required: media-service's base URL. An inspection can reference
# already-uploaded media ids; this service asks media-service to verify
# ownership of newly-referenced ids on create/update, and to hard-delete
# an inspection's files when it's cascade-deleted alongside its hive.
MEDIA_SERVICE_URL=http://localhost:8085

# `docker compose up` (via beebase-gateway) overrides all of the above to
# in-network addresses — you don't need to change them for that path.

# Required: the gateway's externally reachable base URL, used to build
# the image_url returned for each image (PUBLIC_BASE_URL +
# "/api/v1/media/{id}/download"). Unlike the *_SERVICE_URL settings
# above, this one is handed to clients, so it must resolve for them, not
# just for server-to-server calls — it must stay the gateway's address
# even under `docker compose up`, which does NOT override it.
PUBLIC_BASE_URL=http://localhost:8080

# Optional: the number of days after a hive's latest inspection that
# it's considered to need inspection (see
# beebase-common/inspectionwarning). Defaults to 14 when unset. This
# service is the single source of truth for this value - hive-service
# and statistics-service both read it from GET
# /api/v1/inspections/hive-status rather than configuring their own
# copy, so changing it here is the only place it needs to change.
#INSPECTION_WARNING_THRESHOLD_DAYS=14
